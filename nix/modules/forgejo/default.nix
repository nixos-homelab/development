{ inputs, self, ... }:
{
  lib,
  pkgs,
  config,
  ...
}:
let
  ccfg = config.homelab.cluster;
  cfg = config.homelab.forgejo;
  hllib = inputs.homelab-shared.lib;
  hostname = "forgejo.${config.homelab.workloads.domain}";
  ports = {
    web = 3000;
    ssh = 2222;
  };
  secretsDir = "/run/secrets/forgejo";
  # Read-only from the ConfigMap: with every secret given as a file Forgejo has nothing to write back to it
  appIni = lib.generators.toINI { } (
    lib.recursiveUpdate {
      DEFAULT = {
        APP_NAME = "Forgejo";
        RUN_MODE = "prod";
        RUN_USER = "git";
        WORK_PATH = "/data";
      };
      server = {
        DOMAIN = hostname;
        ROOT_URL = "https://${hostname}/";
        HTTP_PORT = ports.web;
        APP_DATA_PATH = "/data";
        # The built-in SSH server on an unprivileged port, where the TCPRoute from port 22 of the Gateway leads
        START_SSH_SERVER = true;
        SSH_DOMAIN = hostname;
        SSH_PORT = 22;
        SSH_LISTEN_PORT = ports.ssh;
        # At a node shutdown the kubelet gives pods 20 s; Forgejo waits 60 s by default for what's in flight
        GRACEFUL_HAMMER_TIME = "10s";
      };
      database = {
        DB_TYPE = "postgres";
        HOST = "postgresql.postgresql:5432";
        NAME = config.homelab.postgresql.databases.forgejo.dbName;
        USER = config.homelab.postgresql.databases.forgejo.username;
        PASSWD_URI = "file:/run/secrets/postgresql/password";
        SSL_MODE = "disable";
      };
      repository.ROOT = "/data/repositories";
      security = {
        INSTALL_LOCK = true;
        SECRET_KEY_URI = "file:${secretsDir}/SECRET_KEY";
        INTERNAL_TOKEN_URI = "file:${secretsDir}/INTERNAL_TOKEN";
      };
      # Also the general signing secret (CSRF and account tokens), so loaded even with OAuth2 off
      oauth2.JWT_SECRET_URI = "file:${secretsDir}/JWT_SECRET";
      service = {
        DISABLE_REGISTRATION = true;
        REQUIRE_SIGNIN_VIEW = true;
      };
      session.PROVIDER = "db";
      log.MODE = "console";
      mailer.ENABLED = false;
      # No egress to the internet
      "cron.update_checker".ENABLED = false;
    } cfg.settings
  );
  # Migrates the database, then creates the admin or sets the password of the admin to the one in the Secret, as postgresql
  # does for its superuser
  start = pkgs.writeShellApplication {
    name = "forgejo-start";
    runtimeInputs = [
      cfg.package
      pkgs.gawk
    ];
    text = ''
      forgejo migrate
      password=$(<${secretsDir}/ADMIN_PASSWORD)
      if forgejo admin user list | awk 'NR > 1 { print $2 }' | grep -qxF "$ADMIN_USERNAME"; then
        forgejo admin user change-password --username "$ADMIN_USERNAME" --password "$password" \
          --must-change-password=false
      else
        forgejo admin user create --admin --username "$ADMIN_USERNAME" --email "$ADMIN_EMAIL" \
          --password "$password" --must-change-password=false
      fi
      unset password
      exec forgejo web
    '';
  };
  image = pkgs.dockerTools.buildImage {
    name = "cluster.local/forgejo";
    copyToRoot = [
      pkgs.dockerTools.usrBinEnv
      pkgs.bashInteractive
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.git
      pkgs.cacert
      cfg.package
      start
    ]
    ++ lib.optionals cfg.debug ccfg.debugTools;
    # Forgejo checks RUN_USER against the user it runs as, by name, and names the SSH user after it
    runAsRoot = ''
      #!${pkgs.runtimeShell}
      ${pkgs.dockerTools.shadowSetup}
      groupadd -r -g ${toString config.homelab.workloads.securityContext.runAsGroup} git
      useradd -r -u ${toString config.homelab.workloads.securityContext.runAsUser} -g git -d /data/home git
    '';
    config.Env = [
      "PATH=/bin:/usr/bin"
      "USER=git"
      "HOME=/data/home"
      "FORGEJO_WORK_DIR=/data"
      # app.ini is read from conf/app.ini in here
      "FORGEJO_CUSTOM=/etc/forgejo"
      "SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt"
    ];
    config.Entrypoint = [ (lib.getExe start) ];
  };
  # Generated only when the Secret is missing, never when the API call fails
  secretSource =
    description: field: generate:
    hllib.setup-secrets.kubeSecretSource pkgs {
      inherit description field generate;
      namespace = "forgejo";
      name = "forgejo-secrets";
    };
  randomString = "head -c 1024 /dev/urandom | tr -dc A-Za-z0-9 | head -c 64";
in
{
  options.homelab.forgejo = {
    enable = lib.mkEnableOption "Forgejo";
    debug = lib.mkEnableOption "debug mode";
    package = lib.mkPackageOption pkgs "forgejo" { };
    admin = {
      username = lib.mkOption {
        description = "Name of the admin user Forgejo creates at start. Its password is generated by setup-secrets, in the Secret `forgejo-secrets` (`ADMIN_PASSWORD`).";
        type = lib.types.str;
        default = "forgejo-admin";
      };
      email = lib.mkOption {
        description = "Email address of the admin user";
        type = lib.types.str;
        default = "forgejo-admin@${config.homelab.workloads.domain}";
        defaultText = lib.literalExpression ''"forgejo-admin@''${config.homelab.workloads.domain}"'';
      };
    };
    storage = lib.mkOption {
      description = "Size of the volume with the repositories and the rest of the data of Forgejo";
      type = lib.types.str;
      default = "10Gi";
    };
    settings = lib.mkOption {
      description = "app.ini settings by section, over those of the module. See the [config cheat sheet](https://forgejo.org/docs/v17.0/admin/config-cheat-sheet/).";
      type =
        with lib.types;
        attrsOf (
          attrsOf (oneOf [
            bool
            int
            str
          ])
        );
      default = { };
      example = {
        repository.DEFAULT_BRANCH = "main";
      };
    };
  };
  imports = [
    inputs.setup-secrets.nixosModules.default
    inputs.homelab-storage.nixosModules.postgresql
  ]
  ++ self.lib.importsApply [ ./homepage.nix ];
  config = lib.mkIf cfg.enable {
    homelab.cluster.images = [ image ];
    homelab.postgresql.databases.forgejo.backup.enable = lib.mkDefault true;
    assertions = [
      {
        assertion = config.homelab.postgresql.enable;
        message = "Forgejo depends on the PostgreSQL service. Enable with `homelab.postgresql.enable=true`";
      }
    ];
    setup-secrets = {
      sources.FORGEJO_SECRET_KEY = secretSource "Forgejo Secret Key" "SECRET_KEY" randomString;
      sources.FORGEJO_INTERNAL_TOKEN =
        secretSource "Forgejo Internal Token" "INTERNAL_TOKEN"
          randomString;
      # 32 bytes in unpadded base64url, the only form Forgejo takes
      sources.FORGEJO_JWT_SECRET =
        secretSource "Forgejo JWT Secret" "JWT_SECRET"
          "head -c 32 /dev/urandom | base64 -w0 | tr '+/' '-_' | tr -d '='";
      sources.FORGEJO_ADMIN_PASSWORD =
        secretSource "Forgejo admin password" "ADMIN_PASSWORD"
          randomString;
      destinations = [
        (hllib.setup-secrets.kubeSecretDestination pkgs {
          logPrefix = "Forgejo (SECRET_KEY, INTERNAL_TOKEN, JWT_SECRET & ADMIN_PASSWORD)";
          namespace = "forgejo";
          name = "forgejo-secrets";
          data = {
            SECRET_KEY = "FORGEJO_SECRET_KEY";
            INTERNAL_TOKEN = "FORGEJO_INTERNAL_TOKEN";
            JWT_SECRET = "FORGEJO_JWT_SECRET";
            ADMIN_PASSWORD = "FORGEJO_ADMIN_PASSWORD";
          };
        })
      ];
    };
    homelab.kubernetes.submodules.instances.forgejo = {
      submodule = "workload";
      args = {
        allowEgress = [ "postgresql" ];
        dataPath = "/data";
        ingressPort = ports.web;
        inherit ports;
        container = {
          image = "${image.buildArgs.name}:${image.imageTag}";
          imagePullPolicy = "Never";
          env.ADMIN_USERNAME.value = cfg.admin.username;
          env.ADMIN_EMAIL.value = cfg.admin.email;
          # /api/healthz checks the database too: a postgresql restart takes Forgejo out of the Service instead of
          # getting it killed. The start migrates the database before the web server listens
          startupProbe = {
            tcpSocket.port = "web";
            failureThreshold = 60;
          };
          livenessProbe.tcpSocket.port = "web";
          readinessProbe.httpGet = {
            path = "/api/healthz";
            port = "web";
          };
          volumeMounts = {
            "/etc/forgejo/conf" = {
              name = "config";
              readOnly = true;
            };
            ${secretsDir} = {
              name = "secrets";
              readOnly = true;
            };
            "/run/secrets/postgresql" = {
              name = "postgresql-password";
              readOnly = true;
            };
            "/tmp".name = "tmp";
          };
        };
      };
      config.kubernetes.resources = {
        configMaps.forgejo.data."app.ini" = appIni;
        persistentVolumeClaims.forgejo.spec.resources.requests.storage = lib.mkForce cfg.storage;
        deployments.forgejo.spec.template.spec.volumes = {
          config.configMap.name = "forgejo";
          secrets.secret.secretName = "forgejo-secrets";
          postgresql-password.secret.secretName = "postgresql-password";
          tmp.emptyDir = { };
        };
        # SSH on the address of the Gateway: port 22 of the Gateway leads to the built-in SSH server. Cilium (1.20)
        # balances a TCPRoute at L4, past Envoy, so the policies of the pod see the client itself: pods with the
        # forgejo or cluster egress label get through, as they do to the port directly
        gateways.forgejo.spec.listeners = [
          {
            name = "forgejo-ssh";
            port = 22;
            protocol = "TCP";
          }
        ];
        tCPRoutes.forgejo = {
          metadata.labels."app.kubernetes.io/name" = "forgejo";
          spec = {
            parentRefs = [
              {
                name = "forgejo";
                sectionName = "forgejo-ssh";
              }
            ];
            rules = [
              {
                backendRefs = [
                  {
                    name = "forgejo";
                    port = ports.ssh;
                  }
                ];
              }
            ];
          };
        };
      };
    };
  };
}
